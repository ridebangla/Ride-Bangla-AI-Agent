generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== MULTI-TENANCY ====================
// Every business-data row belongs to exactly one Business. Cross-business
// access is blocked at the data layer (see src/lib/tenant.ts): all queries
// through the exported `prisma` client are automatically scoped to the
// current request's business. Admin.businessId = null  =>  Super Admin
// (sees everything). Use getUnscopedPrisma() only for setup/seed scripts.

model Business {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  // Public site key for the embeddable website chat widget. Safe to expose
  // in client-side code: it only grants the widget chat flow for this
  // business (heavily rate-limited, no dashboard access).
  siteKey   String   @unique @default(uuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings        Settings?
  admins          Admin[]
  categories      Category[]
  knowledge       KnowledgeEntry[]
  departments     Department[]
  teamMembers     TeamMember[]
  conversations   Conversation[]
  messages        Message[]
  tickets         Ticket[]
  tags            Tag[]
  conversationTags ConversationTag[]
  callLogs        CallLog[]
  channels        Channel[]
  webhooks        Webhook[]
  webhookDeliveries WebhookDelivery[]
  activityLogs    ActivityLog[]
  slaRules        SLARule[]
  cannedResponses CannedResponse[]
  customers       Customer[]
  customerNotes   CustomerNote[]
  automationRules AutomationRule[]
  businessHours   BusinessHours[]
  apiKeys         ApiKey[]
  internalNotes   InternalNote[]
  campaigns       Campaign[]
  flows           Flow[]
  schedules       Schedule[]
  followUps       FollowUp[]
  socialAccounts  SocialAccount[]
  scheduledPosts  ScheduledPost[]
  socialInteractions SocialInteraction[]
  audienceProfiles AudienceProfile[]
  agentCommands   AgentCommand[]
  productCategories ProductCategory[]
  products        Product[]
}

// ==================== SETTINGS ====================

model Settings {
  id              String   @id @default("default")
  businessId      String   @unique
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessName    String   @default("My Business")
  businessDesc    String   @default("")
  welcomeMessage  String   @default("Hello! How can I help you today?")
  tone            String   @default("friendly")
  language        String   @default("auto")
  aiProvider      String   @default("openai")
  aiModel         String   @default("gpt-4o-mini")
  aiApiKey        String   @default("")
  maxTokens       Int      @default(2048)
  temperature     Float    @default(0.7)
  elevenLabsKey   String   @default("")
  elevenLabsVoice String   @default("")
  twilioSid       String   @default("")
  twilioToken     String   @default("")
  twilioPhone     String   @default("")
  smtpHost        String   @default("")
  smtpPort        Int      @default(587)
  smtpUser        String   @default("")
  smtpPass        String   @default("")
  smtpFrom        String   @default("")
  imapHost        String   @default("")
  imapPort        Int      @default(993)
  imapUser        String   @default("")
  imapPass        String   @default("")
  whatsappMode    String   @default("web")
  whatsappApiKey      String   @default("")
  whatsappPhone       String   @default("")
  telegramBotToken    String   @default("")
  // H-16: secret Telegram sends as `secret_token` / `X-Telegram-Bot-Api-Secret-Token`.
  // Inbound updates are rejected unless the header matches this value.
  telegramWebhookSecret String @default("")
  createdAt           DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== AUTH ====================

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String   @default("Admin")
  // super_admin | admin | agent. Only ONE super_admin should exist; it has
  // businessId = null and can see/manage every business.
  role      String   @default("admin")
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // M-53: persistent per-account login lockout (survives tab/IP changes).
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// M-53: JWT revocation list. Logout / refresh rotation insert the token's
// `jti` here; verifySessionToken / verifyRefreshToken reject listed jtis.
// Rows are only useful until the token's expiry — purge expired rows with
// a periodic cleanup job (expiresAt index).
model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ==================== KNOWLEDGE BASE ====================

model Category {
  id          String           @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String           @default("")
  icon        String           @default("folder")
  color       String           @default("#4A7C9B")
  sortOrder   Int              @default(0)
  entries     KnowledgeEntry[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([businessId])
}

model KnowledgeEntry {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String
  content    String
  priority   Int      @default(0)
  isActive   Boolean  @default(true)
  version    Int      @default(1)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])

  @@index([businessId])
}

// ==================== TEAM ====================

model Department {
  id          String       @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String       @default("")
  email       String       @default("")
  members     TeamMember[]
  tickets     Ticket[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([businessId])
}

model TeamMember {
  id           String     @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String     @default("")
  role         String     @default("member")
  expertise    String     @default("")
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isAvailable  Boolean    @default(true)
  tickets      Ticket[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])

  @@index([businessId])
}

// ==================== CONVERSATIONS ====================

model Conversation {
  id              String            @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  channel         String
  customerName    String            @default("Unknown")
  customerContact String            @default("")
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status          String            @default("active")
  satisfaction    Int?
  summary         String            @default("")
  metadata        Json              @default("{}")
  messages        Message[]
  tickets         Ticket[]
  tags            ConversationTag[]
  notes           InternalNote[]
  followUps       FollowUp[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([channel])
  @@index([status])
  @@index([customerContact])
  @@index([channel, status])
  @@index([createdAt])
  @@index([customerId])

  @@index([businessId])
}

model Message {
  id             String       @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  mediaType      String?
  mediaUrl       String?
  toolCalls      Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])

  @@index([businessId])
}

// ==================== TICKETS ====================

model Ticket {
  id             String        @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedToId   String?
  assignedTo     TeamMember?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  title          String
  description    String
  status         String        @default("open")
  priority       String        @default("medium")
  resolution     String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([assignedToId])

  @@index([businessId])
}

// ==================== TAGS ====================

model Tag {
  id            String            @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  color         String            @default("#4A7C9B")
  conversations ConversationTag[]
  createdAt     DateTime          @default(now())

  @@unique([businessId, name])
  @@index([businessId])
}

model ConversationTag {
  id             String       @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tagId          String
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([conversationId, tagId])

  @@index([businessId])
}

// ==================== CALL LOGS ====================

model CallLog {
  id        String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  callSid   String   @unique
  from      String
  to        String
  duration  Int      @default(0)
  status    String   @default("initiated")
  recording String?
  summary   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

// ==================== CHANNELS ===================

model Channel {
  id        String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type      String
  isActive  Boolean  @default(false)
  config    Json     @default("{}")
  status    String   @default("disconnected")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, type])
  @@index([businessId])
}

// ==================== SCHEDULES ====================

model Schedule {
  id           String @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  teamMemberId String
  dayOfWeek    Int
  startTime    String
  endTime      String

  @@index([teamMemberId])
  @@index([dayOfWeek])

  @@index([businessId])
}

// ==================== WEBHOOKS ====================

model Webhook {
  id          String            @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String            @default("")
  url         String
  method      String            @default("POST")
  headers     Json              @default("{}")
  isActive    Boolean           @default(true)
  triggerOn   String
  deliveries  WebhookDelivery[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([businessId])
}

model WebhookDelivery {
  id          String    @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  webhookId   String
  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event       String
  payload     Json
  status      String    @default("pending") // pending, delivered, failed
  statusCode  Int?
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([webhookId])
  @@index([status, nextRetryAt])

  @@index([businessId])
}

// ==================== ACTIVITY LOG ====================

model ActivityLog {
  id          String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  action      String   // conversation.created, ticket.assigned, settings.updated, etc.
  entity      String   // conversation, ticket, settings, knowledge, team
  entityId    String?
  description String
  userId      String?
  userName    String   @default("System")
  metadata    Json     @default("{}")
  requestId   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entity])
  @@index([createdAt])

  @@index([businessId])
}

// ==================== SLA RULES ====================

model SLARule {
  id                String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  description       String   @default("")
  channel           String   @default("all") // all, whatsapp, email, phone
  priority          String   @default("all") // all, low, medium, high, urgent
  firstResponseMins Int      @default(30)
  resolutionMins    Int      @default(480)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([businessId])
}

// ==================== CANNED RESPONSES ====================

model CannedResponse {
  id        String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String   @default("General")
  shortcut  String   @default("") // e.g., /greeting, /refund
  isActive  Boolean  @default(true)
  usageCount Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

// ==================== CUSTOMERS ====================

model Customer {
  id            String         @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  email         String         @default("")
  phone         String         @default("")
  whatsapp      String         @default("")
  tags          String         @default("") // comma-separated
  isBlocked     Boolean        @default(false)
  notes         CustomerNote[]
  conversations Conversation[]
  metadata      Json           @default("{}")
  firstContact  DateTime       @default(now())
  lastContact   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
  @@index([phone])
  @@index([whatsapp])
  @@index([lastContact])

  @@index([businessId])
}

model CustomerNote {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String
  authorName String   @default("Admin")
  createdAt  DateTime @default(now())

  @@index([customerId])

  @@index([businessId])
}

// ==================== AUTOMATION RULES ====================

model AutomationRule {
  id          String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  type        String   // auto_route, auto_tag, auto_reply, keyword_alert
  isActive    Boolean  @default(true)
  conditions  Json     @default("[]") // [{field, operator, value}]
  actions     Json     @default("[]") // [{type, target, value}]
  priority    Int      @default(0)
  triggerCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
}

// ==================== BUSINESS HOURS ====================

model BusinessHours {
  id        String  @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  enabled   Boolean @default(false)
  timezone  String  @default("UTC")
  monday    String  @default("09:00-18:00") // empty = closed
  tuesday   String  @default("09:00-18:00")
  wednesday String  @default("09:00-18:00")
  thursday  String  @default("09:00-18:00")
  friday    String  @default("09:00-18:00")
  saturday  String  @default("")
  sunday    String  @default("")
  offlineMessage String @default("We are currently offline. We will get back to you during business hours.")

  @@unique([businessId])
  @@index([businessId])
}

// ==================== API KEYS ====================

model ApiKey {
  id        String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name      String
  // H-15: ONLY the SHA-256 hash of the key is stored — never the full key.
  // Existing plaintext keys are invalidated by the migration (see
  // 20261013210000_api_key_hash_scopes) and must be re-created (rotation).
  keyHash   String   @unique
  // Last 8 chars of the key, for masked display only.
  keySuffix String   @default("")
  // Per-key permission scopes. A key may only use these permissions.
  scopes    String[] @default([])
  isActive  Boolean  @default(true)
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

// ==================== INTERNAL NOTES ====================

model InternalNote {
  id             String       @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String
  authorName     String       @default("Admin")
  createdAt      DateTime     @default(now())

  @@index([conversationId])

  @@index([businessId])
}

// ==================== CAMPAIGNS ====================

model Campaign {
  id          String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  channel     String   @default("email")
  message     String
  subject     String   @default("")
  segments    Json     @default("[]")
  status      String   @default("draft") // draft, scheduled, running, completed, paused
  scheduledAt DateTime?
  sentCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
}

// ==================== FLOWS ====================

model Flow {
  id          String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  startNodeId String   @default("")
  nodes       Json     @default("[]")
  isActive    Boolean  @default(false)
  triggerCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
}

// ==================== SCHEDULED FOLLOW-UPS ====================
// Real follow-up scheduling (the old schedule_followup AI tool only
// pretended to schedule). Rows are dispatched by POST /api/followups/process
// (call it from a cron); each due item is sent through the conversation's
// channel sender and marked sent.

model FollowUp {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        String
  dueAt          DateTime
  status         String       @default("pending") // pending, sent, cancelled, failed
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([businessId])
  @@index([status, dueAt])
}

// ==================== SOCIAL AUTOMATION ====================
// Pillar 2: scheduled text+picture posts, comment/message auto-reply,
// audience intelligence, admin command queue. NO video generation —
// the user makes videos themselves and posts manually.

// Connected social accounts. Access tokens are stored AES-256-GCM
// encrypted (see src/lib/social/accounts.ts) — never plaintext.
model SocialAccount {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform   String   // facebook | instagram | x | youtube
  label      String   @default("")
  accountRef String   @default("") // page ID, IG user ID, X handle...
  tokenEnc   String   @default("") // AES-256-GCM encrypted access token
  tokenIv    String   @default("")
  isActive   Boolean  @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, platform, accountRef])
  @@index([businessId])
}

// Admin-configurable posting schedule: one row per scheduled post
// (explicit datetime — no hidden recurrence). Dispatched by
// POST /api/social/process (call it from a cron).
model ScheduledPost {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform    String   // facebook | instagram | x
  postType    String   @default("promo") // promo | announcement | engagement | tip
  textContent String   @default("") // empty = agent writes it from topic
  topic       String   @default("")
  imagePrompt String   @default("") // empty = agent invents from topic
  imageUrl    String   @default("") // filled after generation
  scheduledAt DateTime
  status      String   @default("scheduled") // scheduled | posted | failed | cancelled
  resultRef   String   @default("") // platform post ID after posting
  error       String   @default("")
  createdBy   String   @default("admin") // admin | agent
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@index([status, scheduledAt])
}

// Every comment/message/like the agent sees or answers, per platform.
// Powers "reply to EVERYTHING" tracking + engagement learning + customer memory.
model SocialInteraction {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform    String
  kind        String   // comment | message | like | post
  externalId  String   // platform's ID for the object
  parentRef   String   @default("") // post/message this belongs to
  customerRef String   @default("") // platform user ID / handle
  content     String   @default("")
  likes       Int      @default(0)
  replied     Boolean  @default(false)
  repliedAt   DateTime?
  replyRef    String   @default("")
  createdAt   DateTime @default(now())

  @@unique([businessId, platform, externalId])
  @@index([businessId, platform])
  @@index([replied])
}

// Per-platform audience profile, improved over time from engagement data.
// The content generator reads this to pick topics/tone/timing.
model AudienceProfile {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform   String
  // { topTopics: [{topic, score}], bestHours: [9, 18], toneNotes: "...",
  //   demographics: {...}, sampleSize: 123, updatedFrom: "..." }
  data       Json     @default("{}")
  updatedAt  DateTime @updatedAt

  @@unique([businessId, platform])
}

// Admin command queue: the admin writes a task, the agent executes it.
// Processed by POST /api/agent/commands/process (cron or manual).
model AgentCommand {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  command    String
  status     String   @default("queued") // queued | running | done | failed
  result     String   @default("")
  createdBy  String   @default("admin")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@index([status])
}

// ==================== PRODUCT CATALOG ====================
// Pluggable, tenant-configurable product/service catalog. Ride Bangla has
// no own production YET, so this ships empty-but-wired: the models, the
// retrieval/recommendation logic (src/lib/catalog.ts), the AI tools
// (search_catalog, recommend_alternative, take_order) and the admin API
// routes are all real. Any tenant (or future Ride Bangla products) fills
// in rows via the API; the agent immediately starts selling from them.

model ProductCategory {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id          String          @id @default(uuid())
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  description String          @default("")
  price       Float?
  currency    String          @default("BDT")
  imageUrl    String          @default("")
  tags        String          @default("") // comma-separated keywords
  isAvailable Boolean         @default(true)
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([businessId])
  @@index([businessId, isAvailable])
}
