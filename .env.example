# ============================================
# Ride Bangla AI Agent - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# Required variables are marked with [REQUIRED]
# ============================================

# [REQUIRED] Firebase (Firestore) — service-account credentials for the
# Firebase Admin SDK. Create a service account in the Firebase console
# (Project settings > Service accounts) and paste its values here.
# The private key is usually stored with escaped newlines (\n).
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# [REQUIRED] Secret key for JWT token signing (use a random 32+ char string)
JWT_SECRET="change-this-to-a-random-secret"

# [REQUIRED] App URL (used for callbacks and webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment (development | production)
NODE_ENV="development"

# ---- AI Providers ----
# AI keys are server-side only (never in the client bundle, never logged).
# Any ONE of these enables AI; more keys = automatic failover.
# Per-site dedicated keys (Firestore settings.aiKeys) override these per provider.
OPENAI_API_KEY="sk-your-openai-api-key"
GROQ_API_KEY="gsk-your-groq-api-key"
GEMINI_API_KEY="your-gemini-api-key"
# Provider priority order (comma-separated, allowlisted). Default: groq,gemini,openai
AI_PROVIDER_PRIORITY="groq,gemini,openai"

# ---- Phone Channel (Twilio + ElevenLabs) ----
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# ---- Webhook Security ----
# Secret key for HMAC-SHA256 webhook payload signatures
WEBHOOK_SECRET="change-this-to-a-random-secret"

# ---- Cron Jobs ----
# Shared secret for scheduled endpoints (follow-ups, social posts, engagement
# sync, command queue). Call with: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me-to-a-long-random-string"

# ---- Social Automation ----
# 64-char hex (32 bytes) key for AES-256-GCM encryption of stored social
# platform tokens. Generate with: openssl rand -hex 32
SOCIAL_TOKEN_KEY="change-me-to-64-hex-chars"

# ---- CORS (optional) ----
# Set to allow cross-origin API access (e.g., "https://your-frontend.com")
# CORS_ORIGIN=""

# ---- Optional ----
NEXTAUTH_SECRET="change-this-to-a-random-secret"
